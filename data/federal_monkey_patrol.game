#    Federal Monkey Patrol
# by Dave Lawrence & Sam Norman

################################
###   INTRO. FILM LEADER     ###
################################

blank 000000
transition fade 200
picture data/images/leader/leader_2.jpg film
transition spin 800
picture data/images/leader/leader_2.jpg 0 aaaaaa film

picture data/images/leader/leader_1.jpg film
transition spin 800
picture data/images/leader/leader_1.jpg 0 aaaaaa film

blank 000000
transition fade 200

# Mission, story, mission, story...: the game starts straight away, and the
# story (Harlow and the history of the Federal Monkey Patrol) comes in
# short flashback intermissions between the missions
# (data/story/intermissions/, cut down from the 2006 cutscenes).

################################
###   MISSION 1: 3 KONGS     ###
################################

# (a card stays up while the mission after it generates its city)
card 2200 Kill|3 Kongs
transition fade 600
mission killmonkeys.xml
transition fade 1000

################################
###   STORY 1: EARLIER...    ###
################################

storyteller intermissions/1a_wake_up.shot
storyteller intermissions/1b_after_breakfast.shot
transition fade 500

################################
###   MISSION 2: SURVIVE     ###
################################
# top-down, 1942 controls, bananas

card 2200 Survive
transition fade 600
mission survive1.xml
transition fade 1000

################################
###   STORY 2: POLICE HQ     ###
################################

storyteller intermissions/2b_sign_here.shot
storyteller intermissions/2c_windows.shot
storyteller intermissions/2d_get_him_a_plane.shot
transition fade 500

################################
###   MISSION 3: 3 BLONDES   ###
################################
# Monkey Mayhem, with blondes

card 2200 Save|3 Blondes
transition fade 600
mission saveblondes.xml
transition fade 1000

################################
###   STORY 3: BACK AT BASE  ###
################################

storyteller intermissions/3_returning.shot
transition fade 500

################################
###   MISSION 4: SURVIVE     ###
################################
# top-down, steering, harder

card 2200 Survive|Again
transition fade 600
mission survive2.xml
transition fade 1000

################################
###   STORY 4: THE PARTY     ###
###   PLANE                  ###
################################

storyteller intermissions/4_underpants.shot
transition fade 500

################################
###   MISSION 5: MAYHEM      ###
################################
# the climax: Monkey Mayhem with blondes, against the clock: lose one and it's over

card 2400 Mayhem!|Save 3 Blondes|Lose None|Kill 5 Kongs
transition fade 600
mission rescue.xml
transition fade 1000

################################
###   STORY 5: THE END       ###
################################
# Sent off with the blondes and a crate of whiskey... and down they go
# again, over the radio.

storyteller intermissions/5a_send_off.shot
storyteller intermissions/5b_radio.shot
transition fade 1500
card 3500 The End
