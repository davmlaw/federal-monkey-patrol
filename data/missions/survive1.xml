<?xml version="1.0" encoding="iso-8859-1"?>
<!-- The story's second mission: top-down with 1942 controls, kongs on the
     roofs throwing bananas. Dodge them (and shoot the kongs, so fewer are
     throwing) for a minute. -->
<mission>

<startconditions>
  <height>1000</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
  <view>topdown</view>
  <controls>1942</controls>
  <kongs on="rooftops" tower_min="500" height="180" respawn_msecs="4000" health_min="1" health_max="3">12</kongs>
  <!-- every kong in range and on screen throws one this often, at where
       the plane will be when it reaches the top of its arc (an easy
       start: few kongs, slow bananas, a small hit area) -->
  <bananas every_msecs="3800" rise_secs="2.2" hit_radius="11">on</bananas>
  <patrolradius>none</patrolradius>
  <!-- the kongs close round the plane's path, so they come on screen -->
  <roamradius>1200</roamradius>
  <countdown>
    <label>Survive</label>
    <seconds>60</seconds>
  </countdown>
</startconditions>

<outcomes>
  <scenario>
    <condition>
      <stat name="game_seconds" op="gte" value="60" />
    </condition>
    <result>
      <value>next</value>
      <message>You made it through!</message>
    </result>
  </scenario>
</outcomes>

</mission>
