<?xml version="1.0" encoding="iso-8859-1"?>
<!-- The story's first mission: three kongs in the patrol area, and no more
     coming. Shoot them all down. -->
<mission>

<startconditions>
  <height>600</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
  <kongs respawn_msecs="never">3</kongs>
  <!-- just kongs climbing about: no blondes yet -->
  <blondes>off</blondes>
</startconditions>

<outcomes>
  <scenario>
    <condition>
      <stat name="monkey_population" op="eq" value="0" />
    </condition>
    <result>
      <value>next</value>
      <message>Three kongs down. Nice shooting, Harlow!</message>
    </result>
  </scenario>
</outcomes>

</mission>
