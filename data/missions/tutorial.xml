<?xml version="1.0" encoding="iso-8859-1"?>
<mission>

<startconditions>
  <height>20000</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
</startconditions>

<constraints>
  <maxheight>10000</maxheight>
  <minheight>5000</minheight>
  <maxspeed>100</maxspeed>
  <minspeed>50</minspeed>
</constraints>

<outcomes>
  <!-- Just finish the mission after 10 seconds -->
  <scenario>
    <condition>
	<AND>
        	<stat name="game_seconds" op="gte" value="20" />
		<OR>
        		<stat name="monkey_deaths" op="gte" value="5" />
			<stat name="blonde_rescues" op="gte" value="5" />
		</OR>
	</AND>
    </condition>
    <result>
      <value>next</value>
      <message>Time done!</message>
    </result>
  </scenario>

</outcomes>

</mission>
