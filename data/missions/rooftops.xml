<?xml version="1.0" encoding="iso-8859-1"?>
<!-- Rooftops: a top-down game, seen from above the skyscrapers. The kongs
     are all up on the roofs; there is no patrol area and no throttle.
     1942 controls: the plane keeps heading up the screen; left/right slides it across, up/down speeds it up or slows it down. Down as many as you can in the time. -->
<mission>

<startconditions>
  <height>1000</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
  <view>topdown</view>
  <controls>1942</controls>
  <kongs on="rooftops" respawn_msecs="1000" health_min="2" health_max="4">40</kongs>
  <patrolradius>none</patrolradius>
  <radar>off</radar>
  <countdown>
    <label>Time remaining</label>
    <seconds>180</seconds>
  </countdown>
</startconditions>

<outcomes>
  <scenario>
    <condition>
      <stat name="game_seconds" op="gte" value="180" />
    </condition>
    <result>
      <value>next</value>
      <message>Time's up!</message>
    </result>
  </scenario>
</outcomes>

</mission>
