<?xml version="1.0" encoding="iso-8859-1"?>
<!-- The story's last mission, the climax: Monkey Mayhem with blondes and
     against the clock. Forty kongs all round the plane wherever it flies
     (no patrol area or radar), quick to be replaced, carrying blondes off
     up the towers. Catch three and down fifteen kongs in three minutes;
     let one land, or run out of time, and it's game over. -->
<mission>

<startconditions>
  <height>600</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
  <kongs respawn_msecs="1000" health_min="2" health_max="4" climb_chance="0.8">40</kongs>
  <blondes grab_chance="1" max="4">on</blondes>
  <patrolradius>none</patrolradius>
  <radar>off</radar>
  <countdown>
    <label>Time remaining</label>
    <seconds>180</seconds>
  </countdown>
</startconditions>

<outcomes>
  <scenario>
    <condition>
      <and>
        <stat name="blonde_rescues" op="gte" value="3" />
        <stat name="monkey_deaths" op="gte" value="15" />
      </and>
    </condition>
    <result>
      <value>next</value>
      <message>Three blondes saved, fifteen kongs down! The city is yours, Harlow.</message>
    </result>
  </scenario>
  <scenario>
    <condition>
      <stat name="blonde_casualties" op="gte" value="1" />
    </condition>
    <result>
      <value>lost</value>
      <message>She didn't make it. Game over</message>
    </result>
  </scenario>
  <scenario>
    <condition>
      <stat name="game_seconds" op="gte" value="180" />
    </condition>
    <result>
      <value>lost</value>
      <message>Out of time. Game over</message>
    </result>
  </scenario>
</outcomes>

</mission>
