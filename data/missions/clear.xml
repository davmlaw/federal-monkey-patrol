<?xml version="1.0" encoding="iso-8859-1"?>
<!-- Clear the area: a fixed number of kongs in the patrol area and no
     more coming. Shoot them all down. -->
<mission>

<startconditions>
  <height>600</height>
  <model>
    <name>biplane.obj</name>
    <skin>biplane_skin.jpg</skin>
  </model>
  <!-- respawn_msecs="never": these are all there are -->
  <kongs respawn_msecs="never">8</kongs>
</startconditions>

<outcomes>
  <scenario>
    <condition>
      <stat name="monkey_population" op="eq" value="0" />
    </condition>
    <result>
      <value>next</value>
      <message>Area clear!</message>
    </result>
  </scenario>
</outcomes>

</mission>
