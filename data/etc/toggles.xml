<!-- User modifiable settings -->

<toggles>
    <city>
	<foo>
	    <type>float</type>
	    <label>FooMagoo</label>
	    <min>0.1</min>
	    <max>1.0</max>
	    <mod>0.1</mod>
	</foo>

	<foonomod>
	    <type>float</type>
	    <min>0.1</min>
	    <max>1.0</max>
	</foonomod>

	<bar>
	    <type>list</type>
	    <val>Bonobo</val>
	    <val>Chimp</val>
	    <val>Oranghutan</val>
	    <val>Monkey</val>
	</bar>

	<baz>
	    <type>switch</type>
	    <label>Bazziewazzie</label>
	</baz>
    </city>

    <display>
	<resolution>
	    <type>list</type>
	    <val>640x480</val>
	    <val>800x600</val>
	    <val>1024x768</val>
	    <val>1280x1024</val>
	    <val>1600x1200</val>
	</resolution>
    </display>



    <game>
	<lives>
	    <type>float</type>
	    <min>1</min>
	    <max>10</max>
	</lives>
    </game>

    <main>
	<default_game>
		<type>list</type>
		<val>data/federal_monkey_patrol.game</val>
		<val>fly.game</val>
	</default_game>
    </main>


    <physics>
	<gravity>
	    <type>float</type>
	    <label>Gravity</label>
	    <min>-100.0</min>
	    <max>100.0</max>
	</gravity>
    </physics>

    <story>
	<msec_initial>
	    <type>float</type>
	    <label>Text display base(ms)</label>
	    <min>0</min>
	    <max>2000</max>
	    <mod>50</mod>
	</msec_initial>

	<msec_per_word>
	    <type>float</type>
	    <label>Text display/word(ms)</label>
	    <min>0</min>
	    <max>2000</max>
	    <mod>50</mod>
	</msec_per_word>
    </story>


    <tuner>
	<width>
	    <type>float</type>
	    <min>0.1</min>
	    <max>1.0</max>
	    <mod>0.1</mod>
	</width>
	<height>
	    <type>float</type>
	    <min>0.1</min>
	    <max>1.0</max>
	    <mod>0.1</mod>
	</height>
    </tuner>

</toggles>
